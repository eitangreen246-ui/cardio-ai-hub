# Copy to .env.local and fill in. .env files are gitignored - secrets never enter git.

# Supabase project (Settings -> API in the Supabase dashboard)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Anthropic API key - used ONLY by the news worker (scripts/fetch-news.ts)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: cap items processed per news run (default 50)
NEWS_MAX_ITEMS=50
